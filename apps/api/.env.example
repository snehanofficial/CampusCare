# Node Environment
NODE_ENV=production

# Server Configurations
PORT=3000
HOST=0.0.0.0

# Database Connections
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="change_me"
JWT_REFRESH_SECRET="change_me"

# Socket.IO Server Port
SOCKET_PORT=3001

# Allowed frontend origin(s) for CORS/Socket.IO, comma-separated
CORS_ORIGIN="https://your-app.vercel.app"

# SMTP Email Configurations (Nodemailer)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp_mock_user"
SMTP_PASS="smtp_mock_password"
SMTP_FROM="CampusCare Support <noreply@campuscare.edu>"

# Web Push API (VAPID keys)
VAPID_PUBLIC_KEY="mock_vapid_public_key_string"
VAPID_PRIVATE_KEY="mock_vapid_private_key_string"
VAPID_EMAIL="support@campuscare.edu"
