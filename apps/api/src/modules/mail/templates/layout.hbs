<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <title>{{subject}}</title>
  <style>
    /* -------------------------------------
        GLOBAL RESETS
    ------------------------------------- */
    body {
      background-color: #f6f9fc;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
      font-size: 14px;
      line-height: 1.6;
      margin: 0;
      padding: 0;
      -ms-text-size-adjust: 100%;
      -webkit-text-size-adjust: 100%;
    }
    table {
      border-collapse: separate;
      mso-table-lspace: 0pt;
      mso-table-rspace: 0pt;
      width: 100%;
    }
    table td {
      font-family: sans-serif;
      font-size: 14px;
      vertical-align: top;
    }
    /* -------------------------------------
        BODY & CONTAINER
    ------------------------------------- */
    .container {
      display: block;
      margin: 0 auto !important;
      max-width: 580px;
      padding: 10px;
      width: 580px;
    }
    .content {
      box-sizing: border-box;
      display: block;
      margin: 0 auto;
      max-width: 580px;
    }
    /* -------------------------------------
        HEADER, FOOTER, CARDS
    ------------------------------------- */
    .main {
      background: #ffffff;
      border-radius: 8px;
      width: 100%;
      border: 1px solid #e2e8f0;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    }
    .wrapper {
      box-sizing: border-box;
      padding: 32px;
    }
    .header {
      padding: 24px 0;
      text-align: center;
    }
    .header img {
      max-height: 40px;
    }
    .footer {
      clear: both;
      margin-top: 24px;
      text-align: center;
      width: 100%;
    }
    .footer td,
    .footer p,
    .footer span,
    .footer a {
      color: #64748b;
      font-size: 11px;
      text-align: center;
      line-height: 1.5;
    }
    /* -------------------------------------
        TYPOGRAPHY
    ------------------------------------- */
    h1, h2, h3, h4 {
      color: #1e293b;
      font-family: sans-serif;
      font-weight: 700;
      line-height: 1.3;
      margin: 0;
      margin-bottom: 16px;
    }
    h1 {
      font-size: 20px;
      text-align: left;
    }
    p, ul, ol {
      font-family: sans-serif;
      font-size: 14px;
      font-weight: normal;
      margin: 0;
      margin-bottom: 16px;
      color: #475569;
    }
    /* -------------------------------------
        HELPERS
    ------------------------------------- */
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: bold;
      text-transform: uppercase;
      margin-bottom: 16px;
    }
    .badge-info { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .badge-warning { background: #fffbeb; color: #b45309; border: 1px solid #fde68a; }
    .badge-success { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }
    .badge-error { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }

    .meta-box {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      padding: 16px;
      margin-bottom: 20px;
    }
    .meta-box table {
      width: 100%;
    }
    .meta-box td {
      padding: 4px 0;
      font-size: 13px;
    }
    .meta-label {
      font-weight: bold;
      color: #64748b;
      width: 30%;
    }
    .meta-value {
      color: #1e293b;
    }
  </style>
</head>
<body>
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" class="body">
    <tr>
      <td style="vertical-align: top;">&nbsp;</td>
      <td class="container" style="vertical-align: top;">
        <div class="content">
          <!-- HEADER BANNERS -->
          <div class="header">
            <h2 style="color: #6366f1; font-weight: 800; margin: 0; letter-spacing: -0.5px;">CampusCare</h2>
            <p style="font-size: 11px; font-weight: bold; color: #94a3b8; text-transform: uppercase; margin-top: 4px; letter-spacing: 1px;">Campus IT Service Management</p>
          </div>

          <!-- CARDS BODY -->
          <table role="presentation" class="main">
            <tr>
              <td class="wrapper" style="vertical-align: top;">
                <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                  <tr>
                    <td style="vertical-align: top;">
                      {{{body}}}
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>

          <!-- FOOTER -->
          <div class="footer">
            <table role="presentation" border="0" cellpadding="0" cellspacing="0">
              <tr>
                <td class="content-block" style="vertical-align: top;">
                  <p>This is an automated dispatch from CampusCare. Please do not reply directly to this email.</p>
                  <p>&copy; 2026 TechNova University IT Operations. All rights reserved.</p>
                </td>
              </tr>
            </table>
          </div>
        </div>
      </td>
      <td style="vertical-align: top;">&nbsp;</td>
    </tr>
  </table>
</body>
</html>
