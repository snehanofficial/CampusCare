datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------
// User & Authentication Models
// ---------------------------------------------------------

model User {
  id           String    @id @default(uuid()) @map("id")
  email        String    @unique @map("email")
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  avatarUrl    String?   @map("avatar_url")
  phone        String?   @map("phone")
  roleId       String    @map("role_id")
  departmentId String?   @map("department_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  role                  Role                   @relation(fields: [roleId], references: [id])
  department            Department?            @relation("UserDepartment", fields: [departmentId], references: [id])
  permissions           UserPermission[]
  sessions              Session[]
  createdTickets        Ticket[]               @relation("CreatedTickets")
  assignedTickets       Ticket[]               @relation("AssignedTickets")
  comments              TicketComment[]
  performedAuditLogs    AuditLog[]             @relation("PerformedBy")
  performedTransactions InventoryTransaction[] @relation("PerformedBy")
  notifications         Notification[]
  assetHistory          AssetHistory[]
  ticketAttachments     TicketAttachment[]
  kbArticlesCreated     KnowledgeArticle[]    @relation("KBCreatedBy")
  kbArticlesUpdated     KnowledgeArticle[]    @relation("KBUpdatedBy")
  articleFeedbacks      ArticleFeedback[]

  @@index([email])
  @@index([roleId])
  @@index([departmentId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")      // e.g. STUDENT, TECHNICIAN
  displayName String   @map("display_name")       // e.g. "Student", "IT Technician"
  description String?  @map("description")
  isSystem    Boolean  @default(true) @map("is_system") // System roles cannot be deleted
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @map("id")
  code        String   @unique @map("code")         // e.g. "tickets:create"
  displayName String   @map("display_name")          // e.g. "Create Tickets"
  description String?  @map("description")
  category    String   @map("category")              // e.g. "Tickets", "Assets"
  groupLabel  String   @map("group_label")           // e.g. "Support Operations"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles           RolePermission[]
  userPermissions UserPermission[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String    @id @default(uuid()) @map("id")
  userId       String    @map("user_id")
  permissionId String    @map("permission_id")
  isGranted    Boolean   @default(true) @map("is_granted")
  reason       String?   @map("reason")
  grantedById  String?   @map("granted_by_id")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

// Session model: replaces simple RefreshToken — tracks device info for session management
model Session {
  id            String    @id @default(uuid()) @map("id")
  userId        String    @map("user_id")
  tokenHash     String    @unique @map("token_hash")   // SHA-256 of opaque refresh token
  deviceName    String?   @map("device_name")          // "iPhone 15", "Chrome on Windows"
  deviceType    String?   @map("device_type")          // "mobile" | "tablet" | "desktop"
  browser       String?   @map("browser")              // "Chrome 120"
  os            String?   @map("os")                   // "Windows 11"
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  lastActivity  DateTime  @default(now()) @map("last_activity")
  expiresAt     DateTime  @map("expires_at")
  revoked       Boolean   @default(false) @map("revoked")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")       // "LOGOUT" | "SECURITY" | "REUSE_DETECTED"
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([revoked])
  @@map("sessions")
}

// ---------------------------------------------------------
// Support Hierarchy & Ticket Categorization
// ---------------------------------------------------------

model Department {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")
  code        String   @unique @map("code")          // Short code e.g. "CS", "IT"
  description String?  @map("description")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users   User[]    @relation("UserDepartment")
  tickets Ticket[]
  assets  Asset[]

  @@map("departments")
}

model Category {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")
  description String?  @map("description")
  icon        String?  @map("icon")             // Lucide icon name e.g. "Monitor"
  color       String?  @map("color")            // Hex color for UI badge
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tickets Ticket[]

  @@map("categories")
}

// ---------------------------------------------------------
// Ticket & Incident Management Models
// ---------------------------------------------------------

model Ticket {
  id           String    @id @default(uuid()) @map("id")
  ticketNumber String    @unique @map("ticket_number")  // e.g. "INC-1029"
  title        String    @map("title")
  description  String    @map("description")
  status       String    @map("status")       // OPEN | ASSIGNED | IN_PROGRESS | PENDING | RESOLVED | CLOSED
  priority     String    @map("priority")     // LOW | MEDIUM | HIGH | CRITICAL
  creatorId    String    @map("creator_id")
  assigneeId   String?   @map("assignee_id")
  categoryId   String    @map("category_id")
  departmentId String    @map("department_id")
  assetId      String?   @map("asset_id")
  closedAt     DateTime? @map("closed_at")
  resolvedAt   DateTime? @map("resolved_at")
  dueAt        DateTime? @map("due_at")       // SLA deadline
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  creator     User               @relation("CreatedTickets", fields: [creatorId], references: [id])
  assignee    User?              @relation("AssignedTickets", fields: [assigneeId], references: [id])
  category    Category           @relation(fields: [categoryId], references: [id])
  department  Department         @relation(fields: [departmentId], references: [id])
  asset       Asset?             @relation(fields: [assetId], references: [id])
  comments    TicketComment[]
  attachments TicketAttachment[]
  incidents   IncidentTicket[]

  @@index([status])
  @@index([priority])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([categoryId])
  @@index([departmentId])
  @@index([assetId])
  @@index([ticketNumber])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid()) @map("id")
  ticketId   String   @map("ticket_id")
  authorId   String   @map("author_id")
  content    String   @map("content")
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketAttachment {
  id           String   @id @default(uuid()) @map("id")
  ticketId     String   @map("ticket_id")
  fileName     String   @map("file_name")
  fileUrl      String   @map("file_url")
  fileType     String   @map("file_type")
  fileSize     Int      @map("file_size")
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([ticketId])
  @@map("ticket_attachments")
}

model Incident {
  id          String    @id @default(uuid()) @map("id")
  title       String    @map("title")
  description String    @map("description")
  rootCause   String?   @map("root_cause")
  status      String    @map("status")
  severity    String    @default("MEDIUM") @map("severity")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  resolvedAt  DateTime? @map("resolved_at")
  serviceId   String?   @map("service_id")

  tickets  IncidentTicket[]
  service  Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([serviceId])
  @@map("incidents")
}

model IncidentTicket {
  incidentId String @map("incident_id")
  ticketId   String @map("ticket_id")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([incidentId, ticketId])
  @@map("incident_tickets")
}

// ---------------------------------------------------------
// Asset & Inventory Models
// ---------------------------------------------------------

model Asset {
  id             String    @id @default(uuid()) @map("id")
  name           String    @map("name")
  tag            String    @unique @map("tag")         // QR Code identifier
  serialNumber   String?   @unique @map("serial_number")
  model          String    @map("model")
  manufacturer   String?   @map("manufacturer")
  status         String    @map("status")              // OPERATIONAL | MAINTENANCE | BROKEN | RETIRED | LOST
  location       String    @map("location")
  purchaseDate   DateTime? @map("purchase_date")
  warrantyExpiry DateTime? @map("warranty_expiry")
  purchasePrice  Decimal?  @map("purchase_price")
  departmentId   String    @map("department_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  department Department     @relation(fields: [departmentId], references: [id])
  tickets    Ticket[]
  history    AssetHistory[]

  @@index([tag])
  @@index([departmentId])
  @@index([status])
  @@map("assets")
}

model AssetHistory {
  id            String   @id @default(uuid()) @map("id")
  assetId       String   @map("asset_id")
  actionType    String   @map("action_type")  // CREATED | MAINTENANCE | STATUS_CHANGE | ASSIGNED | RETIRED
  notes         String   @map("notes")
  performedById String   @map("performed_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  asset       Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  performedBy User  @relation(fields: [performedById], references: [id])

  @@index([assetId])
  @@map("asset_history")
}

model InventoryItem {
  id          String   @id @default(uuid()) @map("id")
  name        String   @map("name")
  sku         String   @unique @map("sku")
  quantity    Int      @map("quantity")
  minQuantity Int      @default(5) @map("min_quantity")
  unitPrice   Decimal  @map("unit_price")
  location    String?  @map("location")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  transactions InventoryTransaction[]

  @@map("inventory_items")
}

model InventoryTransaction {
  id              String   @id @default(uuid()) @map("id")
  itemId          String   @map("item_id")
  transactionType String   @map("transaction_type")  // ADD | DEDUCT
  quantity        Int      @map("quantity")
  referenceId     String?  @map("reference_id")      // ticket_id or asset_history_id
  notes           String?  @map("notes")
  performedById   String   @map("performed_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  performedBy User          @relation("PerformedBy", fields: [performedById], references: [id])

  @@index([itemId])
  @@map("inventory_transactions")
}

// ---------------------------------------------------------
// Notification & Alert Models
// ---------------------------------------------------------

model Notification {
  id          String   @id @default(uuid()) @map("id")
  userId      String   @map("user_id")
  title       String   @map("title")
  message     String   @map("message")
  isRead      Boolean  @default(false) @map("is_read")
  type        String   @map("type")          // INFO | SUCCESS | WARNING | ERROR
  category    String   @map("category")      // TICKET | ASSET | SYSTEM | MAINTENANCE
  referenceId String?  @map("reference_id")  // Optional link to related entity
  actionUrl   String?  @map("action_url")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model NotificationPreference {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  category  String   @map("category") // TICKET | INCIDENT | ASSET | MAINTENANCE | INVENTORY | SLA | SYSTEM
  email     Boolean  @default(true) @map("email")
  inApp     Boolean  @default(true) @map("in_app")
  push      Boolean  @default(true) @map("push")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, category])
  @@map("notification_preferences")
}

// ---------------------------------------------------------
// SLA & Business Policy Models
// ---------------------------------------------------------

model SlaPolicy {
  id                 String   @id @default(uuid()) @map("id")
  priority           String   @unique @map("priority")          // LOW | MEDIUM | HIGH | CRITICAL
  displayName        String   @map("display_name")               // "Low Priority", etc.
  responseTimeLimit  Int      @map("response_time_limit")        // Minutes to first response
  resolveTimeLimit   Int      @map("resolve_time_limit")         // Minutes to resolution
  escalationRoleName String   @default("DEPT_ADMIN") @map("escalation_role_name")
  warningThreshold   Int      @default(80) @map("warning_threshold") // % of time elapsed before warning
  color              String?  @map("color")                      // UI color for SLA badge
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("sla_policies")
}

// ---------------------------------------------------------
// Service Status Model (Status Page)
// ---------------------------------------------------------

model Service {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")
  description String?  @map("description")
  category    String   @map("category")
  status      String   @map("status")
  icon        String?  @map("icon")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  histories    ServiceStatusHistory[]
  maintenances MaintenanceWindow[]
  incidents    Incident[]

  @@map("services")
}

model ServiceStatusHistory {
  id             String   @id @default(uuid()) @map("id")
  serviceId      String   @map("service_id")
  previousStatus String   @map("previous_status")
  newStatus      String   @map("new_status")
  reason         String?  @map("reason")
  changedBy      String?  @map("changed_by")
  createdAt      DateTime @default(now()) @map("created_at")

  service        Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_status_history")
}

model MaintenanceWindow {
  id          String   @id @default(uuid()) @map("id")
  serviceId   String   @map("service_id")
  title       String   @map("title")
  description String?  @map("description")
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  status      String   @map("status")
  createdAt   DateTime @default(now()) @map("created_at")

  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("maintenance_windows")
}

// ---------------------------------------------------------
// Audit Trail Model
// ---------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid()) @map("id")
  action        String   @map("action")        // AUTH_LOGIN | TICKET_UPDATE | ASSET_CREATE etc.
  targetTable   String   @map("target_table")
  targetId      String   @map("target_id")
  oldValue      Json?    @map("old_value")
  newValue      Json?    @map("new_value")
  performedById String   @map("performed_by_id")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  performedBy User @relation("PerformedBy", fields: [performedById], references: [id])

  @@index([performedById])
  @@index([action])
  @@index([targetTable, targetId])
  @@map("audit_logs")
}

// ---------------------------------------------------------
// Knowledge Base Models
// ---------------------------------------------------------

model KnowledgeCategory {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  articles KnowledgeArticle[]

  @@map("knowledge_categories")
}

model KnowledgeArticle {
  id          String   @id @default(uuid()) @map("id")
  title       String   @map("title")
  slug        String   @unique @map("slug")
  content     String   @map("content")
  summary     String   @map("summary")
  categoryId  String   @map("category_id")
  tags        String[] @map("tags")
  status      String   @default("DRAFT") @map("status")   // DRAFT | PUBLISHED
  createdById String   @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  viewCount   Int      @default(0) @map("view_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category  KnowledgeCategory @relation(fields: [categoryId], references: [id])
  createdBy User              @relation("KBCreatedBy", fields: [createdById], references: [id])
  updatedBy User?             @relation("KBUpdatedBy", fields: [updatedById], references: [id])
  feedbacks ArticleFeedback[]

  @@index([status])
  @@index([categoryId])
  @@index([slug])
  @@map("knowledge_articles")
}

model ArticleFeedback {
  id        String   @id @default(uuid()) @map("id")
  articleId String   @map("article_id")
  userId    String   @map("user_id")
  helpful   Boolean  @map("helpful")
  comment   String?  @map("comment")
  createdAt DateTime @default(now()) @map("created_at")

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([articleId])
  @@map("article_feedbacks")
}

model EmailLog {
  id            String   @id @default(uuid()) @map("id")
  recipient     String   @map("recipient")
  template      String   @map("template")
  status        String   @map("status") // SENT | FAILED | PENDING
  retryCount    Int      @default(0) @map("retry_count")
  error         String?  @map("error")
  recipientType String?  @map("recipient_type")
  eventType     String?  @map("event_type")
  userId        String?  @map("user_id")
  timestamp     DateTime @default(now()) @map("timestamp")

  @@map("email_logs")
}

model PushSubscription {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  endpoint  String   @unique @map("endpoint")
  p256dh    String   @map("p256dh")
  auth      String   @map("auth")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("push_subscriptions")
}

model EmailPreference {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  eventType String   @map("event_type")
  enabled   Boolean  @default(true) @map("enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, eventType])
  @@map("email_preferences")
}

model SystemNotification {
  id        String   @id @default(uuid()) @map("id")
  title     String   @map("title")
  message   String   @map("message")
  sendEmail Boolean  @default(false) @map("send_email")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_notifications")
}
