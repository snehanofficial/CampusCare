datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------
// User & Authentication Models
// ---------------------------------------------------------

model User {
  id           String           @id @default(uuid()) @map("id")
  email        String           @unique @map("email")
  passwordHash String           @map("password_hash")
  firstName    String           @map("first_name")
  lastName     String           @map("last_name")
  roleId       String           @map("role_id")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  role                  Role                   @relation(fields: [roleId], references: [id])
  permissions           UserPermission[]
  createdTickets        Ticket[]               @relation("CreatedTickets")
  assignedTickets       Ticket[]               @relation("AssignedTickets")
  comments              TicketComment[]
  performedAuditLogs    AuditLog[]             @relation("PerformedBy")
  performedTransactions InventoryTransaction[] @relation("PerformedBy")
  notifications         Notification[]
  assetHistory          AssetHistory[]
  ticketAttachments     TicketAttachment[]

  @@index([email])
  @@index([roleId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles            RolePermission[]
  userPermissions  UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String    @id @default(uuid()) @map("id")
  userId       String    @map("user_id")
  permissionId String    @map("permission_id")
  isGranted    Boolean   @default(true) @map("is_granted")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

// ---------------------------------------------------------
// Support Hierarchy & Ticket Categorization
// ---------------------------------------------------------

model Department {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tickets Ticket[]
  assets  Asset[]

  @@map("departments")
}

model Category {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tickets Ticket[]

  @@map("categories")
}

// ---------------------------------------------------------
// Ticket & Incident Management Models
// ---------------------------------------------------------

model Ticket {
  id           String    @id @default(uuid()) @map("id")
  title        String    @map("title")
  description  String    @map("description")
  status       String    @map("status") // e.g. OPEN, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED
  priority     String    @map("priority") // e.g. LOW, MEDIUM, HIGH, CRITICAL
  creatorId    String    @map("creator_id")
  assigneeId   String?   @map("assignee_id")
  categoryId   String    @map("category_id")
  departmentId String    @map("department_id")
  assetId      String?   @map("asset_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  resolvedAt   DateTime? @map("resolved_at")

  creator     User               @relation("CreatedTickets", fields: [creatorId], references: [id])
  assignee    User?              @relation("AssignedTickets", fields: [assigneeId], references: [id])
  category    Category           @relation(fields: [categoryId], references: [id])
  department  Department         @relation(fields: [departmentId], references: [id])
  asset       Asset?             @relation(fields: [assetId], references: [id])
  comments    TicketComment[]
  attachments TicketAttachment[]
  incidents   IncidentTicket[]

  @@index([status])
  @@index([priority])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([categoryId])
  @@index([departmentId])
  @@index([assetId])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid()) @map("id")
  ticketId   String   @map("ticket_id")
  authorId   String   @map("author_id")
  content    String   @map("content")
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketAttachment {
  id           String   @id @default(uuid()) @map("id")
  ticketId     String   @map("ticket_id")
  fileName     String   @map("file_name")
  fileUrl      String   @map("file_url")
  fileType     String   @map("file_type")
  fileSize     Int      @map("file_size")
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([ticketId])
  @@map("ticket_attachments")
}

model Incident {
  id          String    @id @default(uuid()) @map("id")
  title       String    @map("title")
  description String    @map("description")
  rootCause   String?   @map("root_cause")
  status      String    @map("status")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  resolvedAt  DateTime? @map("resolved_at")

  tickets IncidentTicket[]

  @@map("incidents")
}

model IncidentTicket {
  incidentId String @map("incident_id")
  ticketId   String @map("ticket_id")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([incidentId, ticketId])
  @@map("incident_tickets")
}

// ---------------------------------------------------------
// Asset & Inventory Models
// ---------------------------------------------------------

model Asset {
  id             String    @id @default(uuid()) @map("id")
  name           String    @map("name")
  tag            String    @unique @map("tag") // QR Code identifier
  serialNumber   String?   @map("serial_number")
  model          String    @map("model")
  status         String    @map("status") // OPERATIONAL, MAINTENANCE, BROKEN, etc.
  location       String    @map("location")
  purchaseDate   DateTime? @map("purchase_date")
  warrantyExpiry DateTime? @map("warranty_expiry")
  departmentId   String    @map("department_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  department Department     @relation(fields: [departmentId], references: [id])
  tickets    Ticket[]
  history    AssetHistory[]

  @@index([tag])
  @@index([departmentId])
  @@map("assets")
}

model AssetHistory {
  id            String   @id @default(uuid()) @map("id")
  assetId       String   @map("asset_id")
  actionType    String   @map("action_type") // MAINTENANCE, STATUS_CHANGE, etc.
  notes         String   @map("notes")
  performedById String   @map("performed_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  asset       Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  performedBy User  @relation(fields: [performedById], references: [id])

  @@index([assetId])
  @@map("asset_history")
}

model InventoryItem {
  id          String   @id @default(uuid()) @map("id")
  name        String   @map("name")
  sku         String   @unique @map("sku")
  quantity    Int      @map("quantity")
  minQuantity Int      @default(5) @map("min_quantity")
  unitPrice   Decimal  @map("unit_price")
  location    String?  @map("location")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  transactions InventoryTransaction[]

  @@map("inventory_items")
}

model InventoryTransaction {
  id              String   @id @default(uuid()) @map("id")
  itemId          String   @map("item_id")
  transactionType String   @map("transaction_type") // ADD or DEDUCT
  quantity        Int      @map("quantity")
  referenceId     String?  @map("reference_id") // ticket_id or asset_history_id
  notes           String?  @map("notes")
  performedById   String   @map("performed_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  performedBy User          @relation("PerformedBy", fields: [performedById], references: [id])

  @@index([itemId])
  @@map("inventory_transactions")
}

// ---------------------------------------------------------
// Notification & Alert Models
// ---------------------------------------------------------

model Notification {
  id          String   @id @default(uuid()) @map("id")
  userId      String   @map("user_id")
  title       String   @map("title")
  message     String   @map("message")
  isRead      Boolean  @default(false) @map("is_read")
  type        String   @map("type")
  referenceId String?  @map("reference_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ---------------------------------------------------------
// SLA & Business Policy Models
// ---------------------------------------------------------

model SlaPolicy {
  id                 String   @id @default(uuid()) @map("id")
  priority           String   @unique @map("priority") // LOW, MEDIUM, HIGH, CRITICAL
  responseTimeLimit  Int      @map("response_time_limit") // In minutes
  resolveTimeLimit   Int      @map("resolve_time_limit") // In minutes
  escalationRoleName String   @default("DEPT_ADMIN") @map("escalation_role_name")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("sla_policies")
}

// ---------------------------------------------------------
// Audit Trail Model
// ---------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid()) @map("id")
  action        String   @map("action") // e.g. AUTH_LOGIN, TICKET_UPDATE
  targetTable   String   @map("target_table")
  targetId      String   @map("target_id")
  oldValue      Json?    @map("old_value")
  newValue      Json?    @map("new_value")
  performedById String   @map("performed_by_id")
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")

  performedBy User @relation("PerformedBy", fields: [performedById], references: [id])

  @@index([performedById])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------
// Knowledge Base Models
// ---------------------------------------------------------

model KnowledgeBase {
  id        String   @id @default(uuid()) @map("id")
  title     String   @map("title")
  content   String   @map("content")
  category  String   @map("category")
  views     Int      @default(0) @map("views")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("knowledge_base")
}
