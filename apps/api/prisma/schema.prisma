datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------
// User & Authentication Models
// ---------------------------------------------------------

model User {
  id           String    @id @default(uuid()) @map("id")
  email        String    @unique @map("email")
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  avatarUrl    String?   @map("avatar_url")
  phone        String?   @map("phone")
  roleId       String    @map("role_id")
  departmentId String?   @map("department_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  role                  Role                   @relation(fields: [roleId], references: [id])
  department            Department?            @relation("UserDepartment", fields: [departmentId], references: [id])
  permissions           UserPermission[]
  sessions              Session[]
  createdTickets        Ticket[]               @relation("CreatedTickets")
  assignedTickets       Ticket[]               @relation("AssignedTickets")
  comments              TicketComment[]
  performedAuditLogs    AuditLog[]             @relation("PerformedBy")
  notifications         Notification[]
  assetHistory          AssetHistory[]
  ticketAttachments     TicketAttachment[]
  assignmentsReceived   AssetAssignment[]      @relation("AssignedToUser")
  assignmentsCreated    AssetAssignment[]      @relation("AssignedByStaff")
  maintenanceSchedules  MaintenanceSchedule[]  @relation("ScheduleTechnician")
  maintenanceRecords    MaintenanceRecord[]    @relation("RecordTechnician")
  maintenanceHistory    MaintenanceHistory[]   @relation("HistoryPerformedBy")
  // Phase 4 Inventory relations
  performedTransactions InventoryTransaction[] @relation("PerformedBy")
  inventoryAllocations  InventoryAllocation[]  @relation("AllocationAllocatedBy")
  inventoryReservations InventoryReservation[] @relation("ReservationRequestedBy")
  kbArticlesCreated     KnowledgeArticle[]    @relation("KBCreatedBy")
  kbArticlesUpdated     KnowledgeArticle[]    @relation("KBUpdatedBy")
  articleFeedbacks      ArticleFeedback[]

  @@index([email])
  @@index([roleId])
  @@index([departmentId])
  @@map("users")
}


model Role {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")      // e.g. STUDENT, TECHNICIAN
  displayName String   @map("display_name")       // e.g. "Student", "IT Technician"
  description String?  @map("description")
  isSystem    Boolean  @default(true) @map("is_system") // System roles cannot be deleted
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @map("id")
  code        String   @unique @map("code")         // e.g. "tickets:create"
  displayName String   @map("display_name")          // e.g. "Create Tickets"
  description String?  @map("description")
  category    String   @map("category")              // e.g. "Tickets", "Assets"
  groupLabel  String   @map("group_label")           // e.g. "Support Operations"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles           RolePermission[]
  userPermissions UserPermission[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String    @id @default(uuid()) @map("id")
  userId       String    @map("user_id")
  permissionId String    @map("permission_id")
  isGranted    Boolean   @default(true) @map("is_granted")
  reason       String?   @map("reason")
  grantedById  String?   @map("granted_by_id")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

// Session model: replaces simple RefreshToken — tracks device info for session management
model Session {
  id            String    @id @default(uuid()) @map("id")
  userId        String    @map("user_id")
  tokenHash     String    @unique @map("token_hash")   // SHA-256 of opaque refresh token
  deviceName    String?   @map("device_name")          // "iPhone 15", "Chrome on Windows"
  deviceType    String?   @map("device_type")          // "mobile" | "tablet" | "desktop"
  browser       String?   @map("browser")              // "Chrome 120"
  os            String?   @map("os")                   // "Windows 11"
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  lastActivity  DateTime  @default(now()) @map("last_activity")
  expiresAt     DateTime  @map("expires_at")
  revoked       Boolean   @default(false) @map("revoked")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")       // "LOGOUT" | "SECURITY" | "REUSE_DETECTED"
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([revoked])
  @@map("sessions")
}

// ---------------------------------------------------------
// Support Hierarchy & Ticket Categorization
// ---------------------------------------------------------

model Department {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")
  code        String   @unique @map("code")          // Short code e.g. "CS", "IT"
  description String?  @map("description")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users   User[]    @relation("UserDepartment")
  tickets Ticket[]
  assets  Asset[]
  assetAssignments AssetAssignment[] @relation("AssignedToDepartment")
  procurements     Procurement[]

  @@map("departments")
}

model Category {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")
  description String?  @map("description")
  icon        String?  @map("icon")             // Lucide icon name e.g. "Monitor"
  color       String?  @map("color")            // Hex color for UI badge
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tickets Ticket[]

  @@map("categories")
}

// ---------------------------------------------------------
// Ticket & Incident Management Models
// ---------------------------------------------------------

model Ticket {
  id           String    @id @default(uuid()) @map("id")
  ticketNumber String    @unique @map("ticket_number")  // e.g. "INC-1029"
  title        String    @map("title")
  description  String    @map("description")
  status       String    @map("status")       // OPEN | ASSIGNED | IN_PROGRESS | PENDING | RESOLVED | CLOSED
  priority     String    @map("priority")     // LOW | MEDIUM | HIGH | CRITICAL
  creatorId    String    @map("creator_id")
  assigneeId   String?   @map("assignee_id")
  categoryId   String    @map("category_id")
  departmentId String    @map("department_id")
  assetId      String?   @map("asset_id")
  closedAt     DateTime? @map("closed_at")
  resolvedAt   DateTime? @map("resolved_at")
  dueAt        DateTime? @map("due_at")       // SLA deadline
  reopenCount  Int       @default(0) @map("reopen_count")
  reopenReason String?   @map("reopen_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")


  creator     User               @relation("CreatedTickets", fields: [creatorId], references: [id])
  assignee    User?              @relation("AssignedTickets", fields: [assigneeId], references: [id])
  category    Category           @relation(fields: [categoryId], references: [id])
  department  Department         @relation(fields: [departmentId], references: [id])
  asset       Asset?             @relation(fields: [assetId], references: [id])
  comments    TicketComment[]
  attachments TicketAttachment[]
  incidents   IncidentTicket[]

  @@index([status])
  @@index([priority])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([categoryId])
  @@index([departmentId])
  @@index([assetId])
  @@index([ticketNumber])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid()) @map("id")
  ticketId   String   @map("ticket_id")
  authorId   String   @map("author_id")
  content    String   @map("content")
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketAttachment {
  id           String   @id @default(uuid()) @map("id")
  ticketId     String   @map("ticket_id")
  fileName     String   @map("file_name")
  fileUrl      String   @map("file_url")
  fileType     String   @map("file_type")
  fileSize     Int      @map("file_size")
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([ticketId])
  @@map("ticket_attachments")
}

model Incident {
  id          String    @id @default(uuid()) @map("id")
  title       String    @map("title")
  description String    @map("description")
  rootCause   String?   @map("root_cause")
  status      String    @map("status")
  severity    String    @default("MEDIUM") @map("severity")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  resolvedAt  DateTime? @map("resolved_at")
  serviceId   String?   @map("service_id")

  tickets  IncidentTicket[]
  service  Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([serviceId])
  @@map("incidents")
}

model IncidentTicket {
  incidentId String @map("incident_id")
  ticketId   String @map("ticket_id")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([incidentId, ticketId])
  @@map("incident_tickets")
}

// ---------------------------------------------------------
// Asset & Inventory Models
// ---------------------------------------------------------

model Asset {
  id                  String          @id @default(uuid()) @map("id")
  name                String          @map("name")
  assetCode           String          @unique @map("asset_code")
  tag                 String          @unique @map("tag")         // QR Code identifier
  qrCodeId            String?         @unique @map("qr_code_id")
  serialNumber        String?         @unique @map("serial_number")
  model               String          @map("model")
  manufacturer        String?         @map("manufacturer")
  status              AssetStatus     @map("status")
  lifecycleStage      LifecycleStage  @default(PROCURED) @map("lifecycle_stage")
  healthStatus        HealthStatus    @default(HEALTHY) @map("health_status")
  location            String          @map("location")
  building            String?         @map("building")
  floor               String?         @map("floor")
  room                String?         @map("room")
  
  // Procurement details
  purchaseOrderNumber String?         @map("purchase_order_number")
  vendorId            String?         @map("vendor_id")
  purchasePrice       Decimal?        @map("purchase_price")
  purchaseDate        DateTime?       @map("purchase_date")

  // Warranty / AMC details
  warrantyStart       DateTime?       @map("warranty_start")
  warrantyExpiry      DateTime?       @map("warranty_expiry")
  contractNumber      String?         @map("contract_number")

  departmentId        String          @map("department_id")
  categoryId          String?         @map("category_id")
  
  // Audit metadata
  isActive            Boolean         @default(true) @map("is_active")
  createdBy           String?         @map("created_by")
  updatedBy           String?         @map("updated_by")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  healthScore         Int             @default(100) @map("health_score")
  prevHealthScore     Int?            @map("prev_health_score")

  department           Department            @relation(fields: [departmentId], references: [id])
  category             AssetCategory?        @relation(fields: [categoryId], references: [id])
  tickets              Ticket[]
  history              AssetHistory[]
  assignments          AssetAssignment[]
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceRecords   MaintenanceRecord[]

  @@index([tag])
  @@index([assetCode])
  @@index([departmentId])
  @@index([status])
  @@index([lifecycleStage])
  @@index([healthStatus])
  @@map("assets")
}

model AssetHistory {
  id            String   @id @default(uuid()) @map("id")
  assetId       String   @map("asset_id")
  actionType    String   @map("action_type")  // CREATED | MAINTENANCE | STATUS_CHANGE | ASSIGNED | RETIRED
  notes         String   @map("notes")
  performedById String   @map("performed_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  asset       Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  performedBy User  @relation(fields: [performedById], references: [id])

  @@index([assetId])
  @@map("asset_history")
}

enum InventoryCategory {
  SPARE_PART
  CONSUMABLE
  TOOL
  CABLE
  PERIPHERAL
  NETWORKING
  STORAGE
  POWER
  OTHER
}

enum InventoryStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER
  MAINTENANCE_CONSUMPTION
  RESERVATION
  RESERVATION_RELEASE
  SCRAP
}

enum AllocationStatus {
  PENDING
  CONSUMED
  RETURNED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
  CANCELLED
}

model InventoryItem {
  id            String            @id @default(uuid()) @map("id")
  itemCode      String            @unique @map("item_code")       // INV-YYYY-XXXX, immutable
  name          String            @map("name")
  description   String?           @map("description")
  category      InventoryCategory @map("category")
  status        InventoryStatus   @default(ACTIVE) @map("status")
  unit          String            @map("unit")                    // "pcs", "metres", etc.
  manufacturer  String?           @map("manufacturer")
  model         String?           @map("model")
  barcodeQr     String?           @map("barcode_qr")              // optional scanner support
  currentStock  Int               @default(0) @map("current_stock")
  reservedStock Int               @default(0) @map("reserved_stock")
  minimumStock  Int               @default(0) @map("minimum_stock")
  maximumStock  Int               @map("maximum_stock")
  reorderLevel  Int               @map("reorder_level")
  unitCost      Decimal?          @map("unit_cost")
  location      String?           @map("location")
  notes         String?           @map("notes")
  isActive      Boolean           @default(true) @map("is_active") // soft-delete flag
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  transactions  InventoryTransaction[]
  allocations   InventoryAllocation[]
  reservations  InventoryReservation[]

  @@index([itemCode])
  @@index([category])
  @@index([status])
  @@index([reorderLevel])
  @@index([location])
  @@index([barcodeQr])
  @@map("inventory_items")
}

model InventoryTransaction {
  id              String                   @id @default(uuid()) @map("id")
  itemId          String                   @map("item_id")
  transactionType InventoryTransactionType @map("transaction_type")
  quantity        Int                      @map("quantity")
  previousStock   Int                      @map("previous_stock")
  newStock        Int                      @map("new_stock")
  referenceId     String?                  @map("reference_id")   // e.g. maintenanceRecordId
  referenceType   String?                  @map("reference_type") // e.g. "MaintenanceRecord"
  reason          String?                  @map("reason")
  notes           String?                  @map("notes")
  performedById   String                   @map("performed_by_id")
  createdAt       DateTime                 @default(now()) @map("created_at")

  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  performedBy User          @relation("PerformedBy", fields: [performedById], references: [id])

  @@index([itemId])
  @@index([transactionType])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model InventoryAllocation {
  id                  String           @id @default(uuid()) @map("id")
  itemId              String           @map("item_id")
  maintenanceRecordId String           @map("maintenance_record_id")
  quantityRequested   Int              @map("quantity_requested")
  quantityConsumed    Int              @default(0) @map("quantity_consumed")
  status              AllocationStatus @default(PENDING) @map("status")
  notes               String?          @map("notes")
  allocatedById       String           @map("allocated_by_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  item              InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  maintenanceRecord MaintenanceRecord @relation(fields: [maintenanceRecordId], references: [id], onDelete: Cascade)
  allocatedBy       User              @relation("AllocationAllocatedBy", fields: [allocatedById], references: [id])

  @@index([itemId])
  @@index([maintenanceRecordId])
  @@index([status])
  @@map("inventory_allocations")
}

model InventoryReservation {
  id          String            @id @default(uuid()) @map("id")
  itemId      String            @map("item_id")
  quantity    Int               @map("quantity")
  status      ReservationStatus @default(ACTIVE) @map("status")
  requestedBy String            @map("requested_by")
  moduleRef   String?           @map("module_ref")    // "Maintenance" | "Procurement"
  referenceId String?           @map("reference_id")
  expiresAt   DateTime?         @map("expires_at")
  notes       String?           @map("notes")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  reservedBy  User          @relation("ReservationRequestedBy", fields: [requestedBy], references: [id])

  @@index([itemId])
  @@index([status])
  @@index([expiresAt])
  @@map("inventory_reservations")
}

// ---------------------------------------------------------
// Notification & Alert Models
// ---------------------------------------------------------

model Notification {
  id          String   @id @default(uuid()) @map("id")
  userId      String   @map("user_id")
  title       String   @map("title")
  message     String   @map("message")
  isRead      Boolean  @default(false) @map("is_read")
  type        String   @map("type")          // INFO | SUCCESS | WARNING | ERROR
  category    String   @map("category")      // TICKET | ASSET | SYSTEM | MAINTENANCE
  referenceId String?  @map("reference_id")  // Optional link to related entity
  actionUrl   String?  @map("action_url")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model NotificationPreference {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  category  String   @map("category") // TICKET | INCIDENT | ASSET | MAINTENANCE | INVENTORY | SLA | SYSTEM
  email     Boolean  @default(true) @map("email")
  inApp     Boolean  @default(true) @map("in_app")
  push      Boolean  @default(true) @map("push")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, category])
  @@map("notification_preferences")
}

// ---------------------------------------------------------
// SLA & Business Policy Models
// ---------------------------------------------------------

model SlaPolicy {
  id                 String   @id @default(uuid()) @map("id")
  priority           String   @unique @map("priority")          // LOW | MEDIUM | HIGH | CRITICAL
  displayName        String   @map("display_name")               // "Low Priority", etc.
  responseTimeLimit  Int      @map("response_time_limit")        // Minutes to first response
  resolveTimeLimit   Int      @map("resolve_time_limit")         // Minutes to resolution
  escalationRoleName String   @default("DEPT_ADMIN") @map("escalation_role_name")
  warningThreshold   Int      @default(80) @map("warning_threshold") // % of time elapsed before warning
  color              String?  @map("color")                      // UI color for SLA badge
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("sla_policies")
}

// ---------------------------------------------------------
// Service Status Model (Status Page)
// ---------------------------------------------------------

model Service {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")
  description String?  @map("description")
  category    String   @map("category")
  status      String   @map("status")
  icon        String?  @map("icon")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  histories    ServiceStatusHistory[]
  maintenances MaintenanceWindow[]
  incidents    Incident[]

  @@map("services")
}

model ServiceStatusHistory {
  id             String   @id @default(uuid()) @map("id")
  serviceId      String   @map("service_id")
  previousStatus String   @map("previous_status")
  newStatus      String   @map("new_status")
  reason         String?  @map("reason")
  changedBy      String?  @map("changed_by")
  createdAt      DateTime @default(now()) @map("created_at")

  service        Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_status_history")
}

model MaintenanceWindow {
  id          String   @id @default(uuid()) @map("id")
  serviceId   String   @map("service_id")
  title       String   @map("title")
  description String?  @map("description")
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  status      String   @map("status")
  createdAt   DateTime @default(now()) @map("created_at")

  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("maintenance_windows")
}

// ---------------------------------------------------------
// Audit Trail Model
// ---------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid()) @map("id")
  action        String   @map("action")        // AUTH_LOGIN | TICKET_UPDATE | ASSET_CREATE etc.
  targetTable   String   @map("target_table")
  targetId      String   @map("target_id")
  oldValue      Json?    @map("old_value")
  newValue      Json?    @map("new_value")
  performedById String   @map("performed_by_id")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  performedBy User @relation("PerformedBy", fields: [performedById], references: [id])

  @@index([performedById])
  @@index([action])
  @@index([targetTable, targetId])
  @@map("audit_logs")
}

// ---------------------------------------------------------
// Knowledge Base Models
// ---------------------------------------------------------

model KnowledgeCategory {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  articles KnowledgeArticle[]

  @@map("knowledge_categories")
}

model KnowledgeArticle {
  id          String   @id @default(uuid()) @map("id")
  title       String   @map("title")
  slug        String   @unique @map("slug")
  content     String   @map("content")
  summary     String   @map("summary")
  categoryId  String   @map("category_id")
  tags        String[] @map("tags")
  status      String   @default("DRAFT") @map("status")   // DRAFT | PUBLISHED
  createdById String   @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  viewCount   Int      @default(0) @map("view_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category  KnowledgeCategory @relation(fields: [categoryId], references: [id])
  createdBy User              @relation("KBCreatedBy", fields: [createdById], references: [id])
  updatedBy User?             @relation("KBUpdatedBy", fields: [updatedById], references: [id])
  feedbacks ArticleFeedback[]

  @@index([status])
  @@index([categoryId])
  @@index([slug])
  @@map("knowledge_articles")
}

model ArticleFeedback {
  id        String   @id @default(uuid()) @map("id")
  articleId String   @map("article_id")
  userId    String   @map("user_id")
  helpful   Boolean  @map("helpful")
  comment   String?  @map("comment")
  createdAt DateTime @default(now()) @map("created_at")

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([articleId])
  @@map("article_feedbacks")
}

model EmailLog {
  id            String   @id @default(uuid()) @map("id")
  recipient     String   @map("recipient")
  template      String   @map("template")
  status        String   @map("status") // SENT | FAILED | PENDING
  retryCount    Int      @default(0) @map("retry_count")
  error         String?  @map("error")
  recipientType String?  @map("recipient_type")
  eventType     String?  @map("event_type")
  userId        String?  @map("user_id")
  timestamp     DateTime @default(now()) @map("timestamp")

  @@map("email_logs")
}

model PushSubscription {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  endpoint  String   @unique @map("endpoint")
  p256dh    String   @map("p256dh")
  auth      String   @map("auth")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("push_subscriptions")
}

model EmailPreference {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  eventType String   @map("event_type")
  enabled   Boolean  @default(true) @map("enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, eventType])
  @@map("email_preferences")
}

model SystemNotification {
  id        String   @id @default(uuid()) @map("id")
  title     String   @map("title")
  message   String   @map("message")
  sendEmail Boolean  @default(false) @map("send_email")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_notifications")
}

// ---------------------------------------------------------
// Workflow Automation Engine Models
// ---------------------------------------------------------

model AutomationRule {
  id             String   @id @default(uuid()) @map("id")
  name           String   @unique @map("name")
  description    String?  @map("description")
  isActive       Boolean  @default(true) @map("is_active")
  priority       Int      @default(0) @map("priority")       // Lower number = runs first
  trigger        String   @map("trigger")                    // ON_CREATE | ON_UPDATE | ON_STATUS_CHANGE
  conditions     Json     @map("conditions")                 // [{field, operator, value}]
  actions        Json     @map("actions")                    // [{type, value}]
  executionCount Int      @default(0) @map("execution_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  logs AutomationLog[]

  @@index([isActive])
  @@index([trigger])
  @@map("automation_rules")
}

model AutomationLog {
  id         String   @id @default(uuid()) @map("id")
  ruleId     String   @map("rule_id")
  ticketId   String   @map("ticket_id")
  triggered  Boolean  @map("triggered")
  actionsRun Json     @map("actions_run")
  createdAt  DateTime @default(now()) @map("created_at")

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([ticketId])
  @@map("automation_logs")
}

// ---------------------------------------------------------
// Developer B Enums & Asset Category
// ---------------------------------------------------------

enum AssetStatus {
  OPERATIONAL
  MAINTENANCE
  DECOMMISSIONED
  BROKEN
}

enum LifecycleStage {
  PROCURED
  AVAILABLE
  ASSIGNED
  IN_USE
  MAINTENANCE
  RESERVED
  RETURNED
  RETIRED
  DISPOSED
}

enum ProcurementStatus {
  REQUESTED
  ORDERED
  RECEIVED
  REGISTERED
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
  TRANSFERRED
}

enum HealthStatus {
  HEALTHY
  MONITOR
  WARNING
  CRITICAL
  FAILING
}

model AssetCategory {
  id          String   @id @default(uuid()) @map("id")
  name        String   @unique @map("name")
  description String?  @map("description")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assets      Asset[]
  procurements Procurement[]

  @@map("asset_categories")
}

// ---------------------------------------------------------
// Phase 2 Procurement & Asset Assignment Models
// ---------------------------------------------------------

model Procurement {
  id                  String            @id @default(uuid()) @map("id")
  requestNumber       String            @unique @map("request_number")
  purchaseOrderNumber String?           @map("purchase_order_number")
  invoiceNumber       String?           @map("invoice_number")
  purchaseDate        DateTime?         @map("purchase_date")
  purchaseCost        Decimal           @map("purchase_cost")
  vendorReference     String?           @map("vendor_reference")
  status              ProcurementStatus @default(REQUESTED) @map("status")
  assetName           String            @map("asset_name")
  model               String            @map("model")
  manufacturer        String?           @map("manufacturer")
  categoryId          String?           @map("category_id")
  departmentId        String            @map("department_id")
  quantity            Int               @map("quantity")
  registeredCount     Int               @default(0) @map("registered_count")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  department          Department        @relation(fields: [departmentId], references: [id])
  category            AssetCategory?    @relation(fields: [categoryId], references: [id])

  @@index([status])
  @@index([requestNumber])
  @@map("procurements")
}

model AssetAssignment {
  id           String           @id @default(uuid()) @map("id")
  assetId      String           @map("asset_id")
  assigneeType String           @map("assignee_type")
  userId       String?          @map("user_id")
  departmentId String?          @map("department_id")
  location     String?          @map("location")
  assignedAt   DateTime         @default(now()) @map("assigned_at")
  returnedAt   DateTime?        @map("returned_at")
  status       AssignmentStatus @default(ACTIVE) @map("status")
  assignedById String           @map("assigned_by_id")
  notes        String?          @map("notes")

  asset        Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user         User?            @relation("AssignedToUser", fields: [userId], references: [id])
  department   Department?      @relation("AssignedToDepartment", fields: [departmentId], references: [id])
  assignedBy   User             @relation("AssignedByStaff", fields: [assignedById], references: [id])

  @@index([assetId])
  @@index([userId])
  @@index([departmentId])
  @@index([status])
  @@map("asset_assignments")
}

// ---------------------------------------------------------
// Phase 3 Maintenance Management Models
// ---------------------------------------------------------

// ---------------------------------------------------------
// Phase 4 Inventory Enums
// ---------------------------------------------------------

// (The enums above were moved up to accommodate the models)

// ---------------------------------------------------------
// Phase 3 Maintenance Management Enums
// ---------------------------------------------------------

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  CALIBRATION
  SOFTWARE_UPDATE
  HARDWARE_REPAIR
}

enum MaintenanceStatus {
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MaintenanceRecurrence {
  ONE_TIME
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum MaintenanceOutcome {
  SUCCESSFUL
  PARTIALLY_COMPLETED
  FAILED
}

model MaintenanceSchedule {
  id                String                @id @default(uuid()) @map("id")
  assetId           String                @map("asset_id")
  type              MaintenanceType       @map("type")
  technicianId      String?               @map("technician_id")
  priority          MaintenancePriority   @map("priority")
  recurrence        MaintenanceRecurrence @map("recurrence")
  scheduledDate     DateTime              @map("scheduled_date")
  estimatedDuration Int                   @map("estimated_duration") // in minutes
  notes             String?               @map("notes")
  isActive          Boolean               @default(true) @map("is_active")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  asset             Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  technician        User?                 @relation("ScheduleTechnician", fields: [technicianId], references: [id])
  records           MaintenanceRecord[]

  @@index([assetId])
  @@index([technicianId])
  @@map("maintenance_schedules")
}

model MaintenanceRecord {
  id                 String              @id @default(uuid()) @map("id")
  assetId            String              @map("asset_id")
  scheduleId         String?             @map("schedule_id")
  type               MaintenanceType     @map("type")
  status             MaintenanceStatus   @default(SCHEDULED) @map("status")
  priority           MaintenancePriority @map("priority")
  technicianId       String?             @map("technician_id")
  scheduledDate      DateTime            @map("scheduled_date")
  estimatedDuration  Int                 @map("estimated_duration") // in minutes
  actualDuration     Int?                @map("actual_duration")    // in minutes
  startTime          DateTime?           @map("start_time")
  endTime            DateTime?           @map("end_time")
  notes              String?             @map("notes")
  completionNotes    String?             @map("completion_notes")
  cancellationReason String?             @map("cancellation_reason")
  outcome            MaintenanceOutcome? @map("outcome")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  asset                Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  technician           User?                 @relation("RecordTechnician", fields: [technicianId], references: [id])
  schedule             MaintenanceSchedule?  @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  history              MaintenanceHistory[]
  inventoryAllocations InventoryAllocation[]

  @@index([assetId])
  @@index([technicianId])
  @@index([scheduleId])
  @@index([status])
  @@map("maintenance_records")
}

model MaintenanceHistory {
  id            String            @id @default(uuid()) @map("id")
  recordId      String            @map("record_id")
  status        MaintenanceStatus @map("status")
  notes         String?           @map("notes")
  performedById String            @map("performed_by_id")
  createdAt     DateTime          @default(now()) @map("created_at")

  record        MaintenanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  performedBy   User              @relation("HistoryPerformedBy", fields: [performedById], references: [id])

  @@index([recordId])
  @@index([performedById])
  @@map("maintenance_history")
}

model HealthConfiguration {
  id        String   @id @default(uuid()) @map("id")
  key       String   @unique @map("key")
  value     Json     @map("value")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("health_configurations")
}
