{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@prisma/client": ["./node_modules/.prisma/client/default.d.ts"],
      "@prisma/client/*": ["./node_modules/.prisma/client/*"]
    }
  },
  "include": ["src/**/*"]
}
