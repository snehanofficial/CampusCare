# ==============================================================================
# CampusCare Environment Configurations (Example)
# Copy this file to .env and configure actual secrets.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Server Configurations
PORT=3000
HOST=localhost

# Database Connections
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campuscare?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="cc_access_secret_key_change_me_in_production_12345678"
JWT_REFRESH_SECRET="cc_refresh_secret_key_change_me_in_production_87654321"

# Socket.IO Server Port
SOCKET_PORT=3001

# SMTP Email Configurations (Nodemailer)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp_mock_user"
SMTP_PASS="smtp_mock_password"
SMTP_FROM="CampusCare Support <noreply@campuscare.edu>"

# Web Push API (VAPID keys)
# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="mock_vapid_public_key_string"
VAPID_PRIVATE_KEY="mock_vapid_private_key_string"

# ==============================================================================
# React Frontend Configurations (Vite requires VITE_ prefix for browser exposure)
# ==============================================================================
VITE_PORT=5173
VITE_API_URL="http://localhost:3000/api/v1"
VITE_SOCKET_URL="http://localhost:3000"
